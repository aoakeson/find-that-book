# Find That Book: local settings. Copy to .env (repo root, next to FindThatBook.slnx); .env is git-ignored.
# The API and the eval tool both read it. Never commit real keys.
#
# Precedence, lowest to highest:
#   appsettings.json < appsettings.{Environment}.json < user secrets (Development) < this .env file
#   < GEMINI_API_KEY-style environment variables < AI__Gemini__ApiKey-style environment variables < command line
#   < runtime changes from the Development admin API (in memory only; this file is never rewritten).
#
# Empty values are ignored, so this file as-is changes nothing. Any appsettings key can be set here as
# Section__Key=value (double underscore = one level). The commented lines show the defaults.

# --- LLM keys (any one is enough; Gemini is the default provider) -----------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_API_KEY= is accepted too (GEMINI_API_KEY wins if both are set). The judge uses OPENAI_API_KEY
# unless Judge__ApiKey is set.

# --- AI -----------------------------------------------------------------------------------------------------
# AI__Provider=auto                       # auto | gemini | anthropic | openai | none (auto = first of gemini, anthropic, openai with a key; none = heuristic parse + templates)
# AI__Gemini__Model=gemini-3.5-flash-lite
# AI__Anthropic__Model=claude-haiku-5-5
# AI__OpenAI__Model=gpt-4.1-mini
# AI__Gemini__RequestsPerMinute=15        # provider calls per minute, all users together (15 = measured free tier; 0 = unlimited)
# AI__Anthropic__RequestsPerMinute=50
# AI__OpenAI__RequestsPerMinute=50
# AI__Interpret__TimeoutMs=4000
# AI__Explain__TimeoutMs=5000
# AI__Cache__Enabled=true
# AI__Cache__TtlMinutes=1440
# AI__Budget__ExplainReserve=3            # last calls of each minute kept for interpretation (explanations fall back to templates first)
# AI__Budget__DailyCostCapUsd=0.50        # estimated paid-tier spend per UTC day (0 = unlimited)
# AI__Budget__CooldownSeconds=30          # pause after a provider 429
# AI__Pricing__gemini-3.5-flash-lite__InputPerMTok=0.30   # USD per million tokens; the code holds the price table, override a model like this

# --- Judge (OpenAI Decisions second opinion; off by default) ------------------------------------------------
# Judge__Enabled=false
# Judge__Model=gpt-6-luna
# Judge__ApiKey=
# Judge__TimeoutMs=1500                   # one attempt, no retries
# Judge__MaxCandidates=8
# Judge__DailyCostCapUsd=0.50
# Judge__CooldownSeconds=30               # pause after a 429
# Judge__MaxCooldownSeconds=300

# --- Search pipeline ----------------------------------------------------------------------------------------
# Search__DefaultLimit=5
# Search__MaxLimit=10
# Search__MaxCatalogCalls=5               # logical search.json calls per query, cache hits included
# Search__RequestDeadline=00:00:25
# Search__PostRetrievalReserve=00:00:05
# Search__JudgeThreshold=0.9

# --- Open Library -------------------------------------------------------------------------------------------
# OpenLibrary__BaseUrl=https://openlibrary.org/     # e.g. http://127.0.0.1:8090/ for the local mirror (bulk runs only)
# OpenLibrary__PublicUrl=https://openlibrary.org/
# OpenLibrary__CoversUrl=https://covers.openlibrary.org/
# OpenLibrary__UserAgent=FindThatBook/0.1 (+https://github.com/aoakeson/find-that-book; andrew@andrewoakeson.com)
# OpenLibrary__RequestsPerSecond=3

# --- Rate limits (per window; per client IP unless "Global") ------------------------------------------------
# RateLimit__WindowSeconds=60
# RateLimit__SearchPermitsPerIp=20
# RateLimit__SearchPermitsGlobal=60
# RateLimit__SearchConcurrency=6          # searches at once; a burst queues here instead of overflowing Open Library
# RateLimit__SearchQueue=16
# RateLimit__SuggestPermitsPerIp=120
# RateLimit__AdminPermitsPerIp=30

# --- In-memory cache (Open Library and LLM answers) --------------------------------------------------------
# Cache__SizeLimitMegabytes=64            # total payload bytes kept in memory; older entries are evicted beyond it

# --- Autocomplete -------------------------------------------------------------------------------------------
# Suggest__DefaultLimit=8
# Suggest__MaxLimit=10
# Suggest__MaxPrefixLength=100

# --- Behind a reverse proxy (default: none trusted; the socket address is the client) ------------------------
# ForwardedHeaders__KnownProxies__0=10.0.0.5
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/8
# ForwardedHeaders__ForwardLimit=1

# --- Configuration loading itself (set these as real environment variables or arguments, not in .env) -------
# DotEnv__Enabled=true                    # false: ignore this file (keyless runs)
# EnvironmentAliases__Enabled=true        # false: ignore GEMINI_API_KEY-style names in the process environment
