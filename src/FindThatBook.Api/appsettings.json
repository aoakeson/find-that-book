{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Extensions.AI": "Warning",
      "Microsoft.Extensions.Http.Resilience": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Search": {
    "DefaultLimit": 5,
    "MaxLimit": 10,
    "MaxCatalogCalls": 5,
    "RequestDeadline": "00:00:25",
    "PostRetrievalReserve": "00:00:05",
    "JudgeThreshold": 0.9,
    "JudgeMaxCandidates": 8
  },

  "OpenLibrary": {
    "BaseUrl": "https://openlibrary.org/",
    "PublicUrl": "https://openlibrary.org/",
    "CoversUrl": "https://covers.openlibrary.org/",
    "UserAgent": "FindThatBook/0.1 (+https://github.com/aoakeson/find-that-book; andrew@andrewoakeson.com)",
    "RequestsPerSecond": 3
  },

  "AI": {
    "Provider": "auto",
    "Gemini": { "Model": "gemini-3.5-flash-lite" },
    "Anthropic": { "Model": "claude-haiku-5-5" },
    "OpenAI": { "Model": "gpt-4.1-mini" },
    "Budget": { "DailyCostCapUsd": 0.50 }
  },

  "Judge": {
    "Enabled": false,
    "Model": "gpt-6-luna"
  },

  "Suggest": {
    "DefaultLimit": 8,
    "MaxLimit": 10,
    "MaxPrefixLength": 100
  },

  "RateLimit": {
    "WindowSeconds": 60,
    "SearchPermitsPerIp": 20,
    "SearchPermitsGlobal": 60,
    "SearchConcurrency": 6,
    "SearchQueue": 16,
    "SuggestPermitsPerIp": 120,
    "AdminPermitsPerIp": 30
  },

  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  }
}
